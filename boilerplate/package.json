{
  "name": "boilerplate",
  "private": true,
  "scripts": {
    "dev": "bun run --hot app/server.ts",
    "db:reset": "bun ../sivro/cli/scripts/db-reset.script.ts",
    "db:seed": "bun ../sivro/cli/scripts/db-seed.script.ts",
    "migrations:up": "bun ../sivro/cli/scripts/migrate-up.script.ts",
    "migrations:down": "bun ../sivro/cli/scripts/migrate-down.script.ts",
    "migrations:create": "bun ../sivro/cli/scripts/migrate-create.script.ts"
  },
  "dependencies": {
    "hono": "4.10.4",
    "zod": "4.1.12",
    "sivro": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}